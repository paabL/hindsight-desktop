{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hindsight Desktop",
  "version": "0.1.4",
  "identifier": "local.hindsight.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm run bridge:build && npm run web:dev",
    "beforeBuildCommand": "npm run bridge:build && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hindsight Desktop",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../native/HindsightBridge": "native/HindsightBridge",
      "../../LICENSE": "legal/LICENSE",
      "../../NOTICE": "legal/NOTICE",
      "../../PRIVACY.md": "legal/PRIVACY.md",
      "../public/THIRD_PARTY_NOTICES.txt": "legal/THIRD_PARTY_NOTICES.txt",
      "../public/RUST_STANDARD_LIBRARY_NOTICES.txt": "legal/RUST_STANDARD_LIBRARY_NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMTJBMjBBRDNDMkQ0OTcKUldTWDFNTFRDcUlTTGVrUGVvQzRZVUxLdjZueDFXVmRUaTdZVmZCZmM2Z2pGelpRTTYwNFF1a2oK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://raw.githubusercontent.com/paabL/hindsight-desktop/main/updates/beta.json"
      ]
    }
  }
}
