{
  "name": "hindsight-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Independent macOS client for Hindsight",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "bridge:build": "node scripts/build-bridge.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/visual-smoke.mjs",
    "test:graph": "node tests/graph-ui.mjs",
    "test:models": "node tests/models-ui.mjs",
    "format": "prettier --write src scripts tests",
    "web:dev": "vite --host 127.0.0.1",
    "test:i18n": "node tests/i18n-ui.mjs",
    "test:updates": "node tests/updates-ui.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
